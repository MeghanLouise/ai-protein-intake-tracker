# Gemini (server only). Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
PORT=3000

# Firebase project ID (server uses it to verify sign-in tokens and to reach Firestore)
FIREBASE_PROJECT_ID=

# Firestore access: path to a service-account key file from
# Firebase console > Project settings > Service accounts > Generate new private key.
# It's a secret: never commit it or share it. (Files named service-account*.json are git-ignored.)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Firebase web app settings (browser). Public identifiers, not secrets.
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Invite-only sign-up: comma-separated codes people must enter to create an account.
# Generate one with: npm run invite   (if empty, nobody can sign up)
INVITE_CODES=
